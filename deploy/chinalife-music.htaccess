# R1: music files never change once uploaded (random file names), so phones and CDNs may keep them for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(m4a|mp3|wav)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType audio/mp4 .m4a
</IfModule>
